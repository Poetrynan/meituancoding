# ==============================================================================
# SkillCraft 环境变量配置示例
# 注册并创建 Supabase 免费项目 (https://supabase.com) 后在此填入你的连接信息：
# ==============================================================================

# Supabase Project URL (在 Project Settings -> API 中查看)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (在 Project Settings -> API -> anon public 中查看)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
